    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {\r",
                  "    try {\r",
                  "        const jsonData = pm.response.json();\r",
                  "\r",
                  "        // Check if accessToken is inside data\r",
                  "        if (jsonData.data && jsonData.data.accessToken) {\r",
                  "            pm.collectionVariables.set(\"accessTokenMahasiswa\", jsonData.data.accessToken);\r",
                  "            console.log(\"Access token saved to collection variables.\");\r",
                  "        } else {\r",
                  "            console.warn(\"No accessToken found in response data.\");\r",
                  "        }\r",
                  "    } catch (e) {\r",
                  "        console.error(\"Failed to parse response JSON:\", e);\r",
                  "    }\r",
                  "} else {\r",
                  "    console.error(\"Authentication failed with status code:\", pm.response.code);\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],

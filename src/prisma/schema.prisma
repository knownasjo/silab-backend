generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    MAHASISWA
    LABORAN
    ASISTEN
    DOSEN
}

enum ClassRoom {
    PSI
    SBTI
}

enum DaysOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
}

enum DeviceCheck {
    BIASA
    TIDAK_BIASA
    SUDAH_DICEK
}

enum AcademicTerm {
    GANJIL
    GENAP
}

enum AnnouncementTypes {
    ASSISTANT
    PRACTICUM
    INHALL
    BASIC
}

model mst_user {
    id                String    @id @default(uuid())
    fullname          String
    nim               String    @unique
    email             String    @unique
    password          String
    role              UserRole
    passwordChangedAt DateTime?

    subjectLecturer     mst_subject[]              @relation(name: "SubjectLecturer")
    subjectUpdatedBy    mst_subject[]              @relation(name: "SubjectUpdatedBy")
    subjectCreatedBy    mst_subject[]              @relation(name: "SubjectCreatedBy")
    classEnrollments    trn_class_participants[]   @relation(name: "UserEnrollments")
    userActivation      trn_activations[]          @relation(name: "UserActivation")
    meetingParticipants trn_meeting_participants[] @relation(name: "MeetingParticipants")
    announcements       mst_announcement[]         @relation(name: "AnnouncementAuthor")
    classCollaborators  trn_class_collaborator[]   @relation(name: "ClassCollaborators")
    passwordReset       trn_password_resets?       @relation(name: "UserPasswordReset")
    devices             trn_user_devices[]         @relation(name: "UserDevices")

    @@index([id, nim])
}

model mst_subject {
    id          String    @id @default(uuid())
    subjectCode String
    subjectName String
    semester    String
    lecturerId  String
    updatedBy   String?
    createdBy   String
    updatedAt   DateTime?
    createdAt   DateTime? @default(now())
    deletedAt   DateTime?

    lecturer          mst_user                    @relation(name: "SubjectLecturer", fields: [lecturerId], references: [id])
    updater           mst_user?                   @relation(name: "SubjectUpdatedBy", fields: [updatedBy], references: [id])
    creator           mst_user                    @relation(name: "SubjectCreatedBy", fields: [createdBy], references: [id])
    subjectActivation trn_activations[]           @relation(name: "SubjectActivation")
    classes           mst_class[]
    announcements     trn_announcement_subjects[] @relation(name: "SubjectAnnouncements")

    @@index([id, subjectCode])
}

model mst_academic_period {
    id        String       @id @default(uuid())
    year      String
    term      AcademicTerm
    createdBy String?
    createdAt DateTime     @default(now())

    classes     mst_class[]       @relation(name: "ClassPeriod")
    activations trn_activations[] @relation(name: "ActivationPeriod")
    sessions    mst_session[]     @relation(name: "PeriodSessions")
    announcements mst_announcement[] @relation(name: "AnnouncementPeriod")

    @@unique([year, term])
}

model mst_class {
    id        String     @id @default(uuid())
    subjectId String
    periodId  String
    name      String
    quota     Int
    day       DaysOfWeek
    startAt   String
    endAt     String
    room      ClassRoom
    sessionId String?
    updatedBy String?
    createdBy String
    updatedAt DateTime?
    createdAt DateTime?  @default(now())
    deletedAt DateTime?

    participants  trn_class_participants[] @relation(name: "ClassParticipants")
    meetings      trn_meetings[]           @relation(name: "ClassMeeting")
    subject       mst_subject              @relation(fields: [subjectId], references: [id])
    period        mst_academic_period      @relation(name: "ClassPeriod", fields: [periodId], references: [id])
    session       mst_session?             @relation(name: "ClassSession", fields: [sessionId], references: [id])
    collaborators trn_class_collaborator[] @relation(name: "ClassCollaborators")

    @@index([id, subjectId])
    @@index([periodId])
}

model mst_session {
    id        String     @id @default(uuid())
    periodId  String
    room      ClassRoom
    day       DaysOfWeek
    number    Int
    startAt   String
    endAt     String
    isActive  Boolean    @default(true)
    updatedBy String?
    createdBy String
    updatedAt DateTime?
    createdAt DateTime?  @default(now())

    period  mst_academic_period @relation(name: "PeriodSessions", fields: [periodId], references: [id], onDelete: Cascade)
    classes mst_class[]         @relation(name: "ClassSession")

    @@unique([periodId, room, day, number])
}

model trn_class_participants {
    classId   String
    userId    String
    createdAt DateTime  @default(now())
    updatedAt DateTime?
    deletedAt DateTime?

    class mst_class @relation(name: "ClassParticipants", fields: [classId], references: [id])
    user  mst_user  @relation(name: "UserEnrollments", fields: [userId], references: [id])

    @@unique([classId, userId])
    @@index([classId, userId])
}

model trn_activations {
    id        String    @id @default(uuid())
    userId    String
    subjectId String
    periodId  String
    status    Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime?
    deletedAt DateTime?

    user    mst_user             @relation(name: "UserActivation", fields: [userId], references: [id])
    subject mst_subject          @relation(name: "SubjectActivation", fields: [subjectId], references: [id])
    period  mst_academic_period  @relation(name: "ActivationPeriod", fields: [periodId], references: [id])

    @@unique([userId, subjectId, periodId])
    @@index([userId])
    @@index([subjectId])
    @@index([periodId])
}

model trn_meetings {
    id        String    @id @default(uuid())
    classId   String
    name      String
    token     String
    status    Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime?
    deletedAt DateTime?

    class        mst_class                  @relation("ClassMeeting", fields: [classId], references: [id])
    participants trn_meeting_participants[] @relation("MeetingParticipants")

    @@index([id, classId])
}

model trn_meeting_participants {
    meetingId   String
    userId      String
    status      Boolean
    deviceId    String?
    deviceCheck DeviceCheck?
    createdAt   DateTime     @default(now())

    meeting trn_meetings @relation("MeetingParticipants", fields: [meetingId], references: [id])
    user    mst_user     @relation("MeetingParticipants", fields: [userId], references: [id])

    @@unique([meetingId, userId])
    @@unique([meetingId, deviceId])
    @@index([meetingId, userId])
}

model trn_user_devices {
    id          String   @id @default(uuid())
    userId      String
    deviceId    String
    isUsual     Boolean  @default(false)
    firstSeenAt DateTime @default(now())
    lastSeenAt  DateTime @default(now())

    user mst_user @relation(name: "UserDevices", fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, deviceId])
    @@index([deviceId])
}

model mst_announcement {
    id        String            @id @default(uuid())
    type      AnnouncementTypes
    title     String
    body      String
    author    String
    createdAt DateTime          @default(now())
    updatedAt DateTime?
    deletedAt DateTime?
    forAll    Boolean           @default(true)
    periodId  String?

    announcementAuthor mst_user @relation(name: "AnnouncementAuthor", fields: [author], references: [id])
    period             mst_academic_period? @relation(name: "AnnouncementPeriod", fields: [periodId], references: [id], onDelete: Cascade)
    subjects           trn_announcement_subjects[] @relation(name: "AnnouncementSubjects")

    @@index([periodId])
}

model trn_announcement_subjects {
    announcementId String
    subjectId      String

    announcement mst_announcement @relation(name: "AnnouncementSubjects", fields: [announcementId], references: [id], onDelete: Cascade)
    subject      mst_subject      @relation(name: "SubjectAnnouncements", fields: [subjectId], references: [id], onDelete: Cascade)

    @@id([announcementId, subjectId])
    @@index([subjectId])
}

model trn_class_collaborator {
    id        String    @id @default(uuid())
    userId    String
    classId   String
    createdAt DateTime  @default(now())
    updatedAt DateTime?
    deletedAt DateTime?

    user  mst_user  @relation(name: "ClassCollaborators", fields: [userId], references: [id])
    class mst_class @relation(name: "ClassCollaborators", fields: [classId], references: [id])

    @@unique([userId, classId])
    @@index([classId])
    @@index([userId])
}

model trn_registrations {
    id        String   @id @default(uuid())
    email     String   @unique
    nim       String   @unique
    fullname  String
    password  String
    code      String
    attempts  Int      @default(0)
    expiresAt DateTime
    sentAt    DateTime
    createdAt DateTime @default(now())
}

model trn_password_resets {
    id        String   @id @default(uuid())
    userId    String   @unique
    code      String
    attempts  Int      @default(0)
    expiresAt DateTime
    sentAt    DateTime
    createdAt DateTime @default(now())

    user mst_user @relation(name: "UserPasswordReset", fields: [userId], references: [id], onDelete: Cascade)
}

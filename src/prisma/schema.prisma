generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum UserRole {
    MAHASISWA
    LABORAN
    ASISTEN
    DOSEN
}

enum ClassRoom {
    PSI
    SBTI
}

enum DaysOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
}

enum AnnouncementTypes {
    ASSISTANT
    PRACTICUM
    INHALL
    BASIC
}

model mst_user {
    id       String   @id @default(uuid())
    fullname String
    nim      String   @unique
    email    String   @unique
    password String
    role     UserRole

    subjectLecturer          mst_subject[]              @relation(name: "SubjectLecturer")
    subjectUpdatedBy         mst_subject[]              @relation(name: "SubjectUpdatedBy")
    subjectCreatedBy         mst_subject[]              @relation(name: "SubjectCreatedBy")
    classEnrollments         trn_class_participants[]   @relation(name: "UserEnrollments")
    userActivation           trn_activations[]          @relation(name: "UserActivation")
    trn_meeting_participants trn_meeting_participants[] @relation(name: "MeetingParticipants")
    mst_announcement         mst_announcement[]         @relation(name: "AnnouncementAuthor")
    trn_class_collaborator   trn_class_collaborator[]   @relation(name: "ClassCollaborators")

    @@index([id, nim])
}

model mst_subject {
    id           String    @id @default(uuid())
    subject_code String
    subject_name String
    semester     String
    lecturer_id  String
    updated_by   String?
    created_by   String
    updated_at   DateTime?
    created_at   DateTime? @default(now())
    deleted_at   DateTime?

    lecturer          mst_user          @relation(name: "SubjectLecturer", fields: [lecturer_id], references: [id])
    updatedBy         mst_user?         @relation(name: "SubjectUpdatedBy", fields: [updated_by], references: [id])
    createdBy         mst_user          @relation(name: "SubjectCreatedBy", fields: [created_by], references: [id])
    subjectActivation trn_activations[] @relation(name: "SubjectActivation")
    mst_class         mst_class[]

    @@index([id, subject_code])
}

model mst_class {
    id         String     @id @default(uuid())
    subjectId  String
    name       String
    quota      Int
    day        DaysOfWeek
    startAt    String
    endAt      String
    room       ClassRoom
    updated_by String?
    created_by String
    updated_at DateTime?
    created_at DateTime?  @default(now())
    deleted_at DateTime?

    participants           trn_class_participants[] @relation(name: "ClassParticipants")
    trn_meetings           trn_meetings[]           @relation(name: "ClassMeeting")
    subject                mst_subject              @relation(fields: [subjectId], references: [id])
    trn_class_collaborator trn_class_collaborator[] @relation(name: "ClassCollaborators")

    @@index([id, subjectId])
}

model trn_class_participants {
    classId    String
    userId     String
    createdAt  DateTime  @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    class mst_class @relation(name: "ClassParticipants", fields: [classId], references: [id])
    user  mst_user  @relation(name: "UserEnrollments", fields: [userId], references: [id])

    @@unique([classId, userId])
    @@index([classId, userId])
}

model trn_activations {
    id         String    @id @default(uuid())
    userId     String
    subjectId  String
    status     Boolean   @default(false)
    createdAt  DateTime  @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    user    mst_user    @relation(name: "UserActivation", fields: [userId], references: [id])
    subject mst_subject @relation(name: "SubjectActivation", fields: [subjectId], references: [id])

    @@unique([userId, subjectId])
    @@index([userId])
    @@index([subjectId])
}

model trn_meetings {
    id         String    @id @default(uuid())
    classId    String
    name       String
    token      String
    status     Boolean   @default(false)
    createdAt  DateTime  @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    class        mst_class                  @relation("ClassMeeting", fields: [classId], references: [id])
    participants trn_meeting_participants[] @relation("MeetingParticipants")

    @@index([id, classId])
}

model trn_meeting_participants {
    meetingId String
    userId    String
    status    Boolean
    createdAt DateTime @default(now())

    meeting trn_meetings @relation("MeetingParticipants", fields: [meetingId], references: [id])
    user    mst_user     @relation("MeetingParticipants", fields: [userId], references: [id])

    @@unique([meetingId, userId])
    @@index([meetingId, userId])
}

model mst_announcement {
    id         String            @id @default(uuid())
    type       AnnouncementTypes
    title      String
    body       String
    author     String
    createdAt  DateTime          @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    announcementAuthor mst_user @relation(name: "AnnouncementAuthor", fields: [author], references: [id])
}

model trn_class_collaborator {
    id        String    @id @default(uuid())
    userId    String
    classId   String
    createdAt DateTime  @default(now())
    updatedAt DateTime?
    deletedAt DateTime?

    user  mst_user  @relation(name: "ClassCollaborators", fields: [userId], references: [id])
    class mst_class @relation(name: "ClassCollaborators", fields: [classId], references: [id])

    @@unique([userId, classId])
    @@index([classId])
    @@index([userId])
}
